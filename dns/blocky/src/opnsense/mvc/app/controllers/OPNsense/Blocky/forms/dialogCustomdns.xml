<form>
    <field>
        <id>customdns.enabled</id>
        <label>Enabled</label>
        <type>checkbox</type>
        <help>Enable this host override.</help>
        <grid_view>
            <width>6em</width>
            <type>boolean</type>
            <formatter>rowtoggle</formatter>
        </grid_view>
    </field>
    <field>
        <id>customdns.domain</id>
        <label>Domain</label>
        <type>text</type>
        <help>Domain to answer locally, e.g. printer.lan. Subdomains are matched automatically.</help>
        <grid_view/>
    </field>
    <field>
        <id>customdns.ip</id>
        <label>IP addresses</label>
        <type>select_multiple</type>
        <style>tokenize</style>
        <allownew>true</allownew>
        <hint>e.g. 192.168.1.10</hint>
        <help>One or more IPv4/IPv6 addresses returned for this domain. Type a value and press Enter to add it.</help>
        <grid_view/>
    </field>
    <field>
        <id>customdns.description</id>
        <label>Description</label>
        <type>text</type>
        <help>Optional description for your reference.</help>
        <grid_view/>
    </field>
</form>
