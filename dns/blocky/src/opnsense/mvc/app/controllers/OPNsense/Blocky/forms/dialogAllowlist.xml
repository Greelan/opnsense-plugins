<form>
    <field>
        <id>allowlist.enabled</id>
        <label>Enabled</label>
        <type>checkbox</type>
        <help>Enable this allow list.</help>
        <grid_view>
            <width>6em</width>
            <type>boolean</type>
            <formatter>rowtoggle</formatter>
        </grid_view>
    </field>
    <field>
        <id>allowlist.group</id>
        <label>Group</label>
        <type>text</type>
        <help>Blocking group this allow list applies to. Entries here override deny lists in the same group.</help>
        <grid_view/>
    </field>
    <field>
        <id>allowlist.source</id>
        <label>Source</label>
        <type>text</type>
        <help>A https URL to a hosts/domain list, a local file path, or a single inline entry (e.g. good.example.com).</help>
        <grid_view/>
    </field>
    <field>
        <id>allowlist.description</id>
        <label>Description</label>
        <type>text</type>
        <help>Optional description for your reference.</help>
        <grid_view/>
    </field>
</form>
